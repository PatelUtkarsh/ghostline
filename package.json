{
	"name": "ghostline",
	"version": "1.1.0",
	"description": "Cursor animations, linked to the scroll, for text in headings and paragraphs.",
	"author": "Ghostline contributors",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build editor/index=./src/editor/index.js view/index=./src/view/index.js motion-click/index=./src/view/entries/click.js motion-type/index=./src/view/entries/type.js motion-shape/index=./src/view/entries/shape.js motion-replace/index=./src/view/entries/replace.js",
		"start": "wp-scripts start editor/index=./src/editor/index.js view/index=./src/view/index.js motion-click/index=./src/view/entries/click.js motion-type/index=./src/view/entries/type.js motion-shape/index=./src/view/entries/shape.js motion-replace/index=./src/view/entries/replace.js",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style --allow-empty-input",
		"lint:php": "composer run lint",
		"lint:phpstan": "composer run analyse",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php && npm run lint:phpstan",
		"test:unit": "wp-scripts test-unit-jest",
		"test:e2e": "wp-scripts test-playwright",
		"test:php": "composer run test",
		"test": "npm run test:unit && npm run test:php",
		"playground": "wp-playground-cli server --php=8.1 --mount-before-install=.:/wordpress/wp-content/plugins/ghostline --blueprint=./blueprint.json --login",
		"plugin-zip": "wp-scripts plugin-zip",
		"size": "node bin/check-size.js",
		"brand": "node bin/brand-assets.cjs"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@playwright/test": "^1.63.0",
		"@wordpress/babel-plugin-import-jsx-pragma": "^5.56.0",
		"@wordpress/babel-preset-default": "^8.55.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/primitives": "^4.56.0",
		"@wordpress/rich-text": "^7.56.0",
		"@wordpress/scripts": "^36.0.0",
		"@wp-playground/cli": "^3.1.56",
		"babel-jest": "^30.5.0",
		"eslint-plugin-jest": "^29.16.6",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0"
	},
	"files": [
		"ghostline.php",
		"includes",
		"build",
		"src",
		"readme.txt"
	]
}
